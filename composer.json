{
    "name": "libertjeremy/symfony-security-helpers",
    "type": "library",
    "authors": [
        {
            "name": "libertjeremy",
            "email": "contact@libertjeremy.fr"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.0 || ^8.0",
        "symfony/string": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "LibertJeremy\\Symfony\\SecurityHelpers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibertJeremy\\Symfony\\SecurityHelpers\\Tests\\": "tests/"
        }
    }
}
